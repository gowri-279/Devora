# =============================================================================
# DEVORA — Root Environment Variables
# Copy this file to .env and fill in your values.
# This file is loaded by backend/app/main.py (../../.env relative to app).
# All Python services also call load_dotenv() which picks this up.
# =============================================================================

# ---------------------------------------------------------------------------
# MongoDB Atlas
# ---------------------------------------------------------------------------
# Your Atlas connection string. Get it from: Atlas UI > Connect > Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=devora
MONGODB_COLLECTION=knowledge_chunks

# ---------------------------------------------------------------------------
# Service URLs (leave as defaults when running all services locally)
# ---------------------------------------------------------------------------
KNOWLEDGE_ENGINE_URL=http://127.0.0.1:8001
AI_INTEGRATION_URL=http://127.0.0.1:8002
REPOSITORY_PARSER_URL=http://127.0.0.1:8003

# Used by knowledge-engine/app/curriculum_client.py
DEVORA_AI_INTEGRATION_URL=http://127.0.0.1:8002

# Used by devora-mcp/server.py  - MUST point to backend (8000), not KE (8001)
DEVORA_BACKEND_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# IBM Bob / Bob Shell
# ---------------------------------------------------------------------------
# Your IBM Bob API key (required for assessment evaluation + curriculum gen)
BOB_API_KEY=
IBM_BOB_API_KEY=

# Set to "mock" to skip Bob CLI calls during development (no key needed)
# Set to "live" to use the real Bob Shell CLI
DEVORA_BOB_MODE=mock

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# The backend API base URL seen by the browser
VITE_DEVORA_API_URL=http://127.0.0.1:8000/api

# ---------------------------------------------------------------------------
# Repository Parser (optional - only needed if parser is deployed remotely)
# ---------------------------------------------------------------------------
PARSER_BASE_URL=
